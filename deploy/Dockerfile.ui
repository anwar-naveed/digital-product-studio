# Dockerfile.ui
# admin-ui: static React build served by nginx.
# BUILT ONLY BY GITHUB ACTIONS (never on this host — HARD CLAUSE 2).
FROM node:22-bookworm-slim AS builder

WORKDIR /app

# Install deps first for layer caching (npm install happens INSIDE this image on the CI runner)
COPY admin-ui/package.json admin-ui/package-lock.json* ./
RUN npm install --no-audit --no-fund

# Build the static bundle
COPY admin-ui/ ./
RUN npm run build

# ---- Runtime: nginx static serve ----
FROM nginx:1.27-alpine

# Remove default site; ship ours
RUN rm -f /etc/nginx/conf.d/default.conf
COPY deploy/nginx-admin-ui.conf /etc/nginx/conf.d/admin-ui.conf

# Static bundle from builder
COPY --from=builder /app/dist /usr/share/nginx/html

# Non-root: nginx master runs as root by default; drop to unprivileged config
RUN chown -R nginx:nginx /usr/share/nginx/html /var/cache/nginx /var/run /var/log/nginx \
 && touch /var/run/nginx.pid && chown nginx:nginx /var/run/nginx.pid
USER nginx

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1:8080/healthz || exit 1

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
