  "query": "\n        SELECT dv.id, dv.design_id, dv.s3_key, dv.sha256, dv.kind, dv.created_at\n        FROM design_variants dv\n        JOIN designs d ON dv.design_id = d.id\n        WHERE d.run_id = $1\n        ORDER BY dv.created_at ASC\n        ",
