  "query": "\n        SELECT \n            tool as \"tool: JobTool\",\n            status as \"status: JobStatus\",\n            count(*) as count\n        FROM jobs\n        WHERE status IN ('claimed', 'running')\n        GROUP BY tool, status\n        ORDER BY tool, status\n        ",
