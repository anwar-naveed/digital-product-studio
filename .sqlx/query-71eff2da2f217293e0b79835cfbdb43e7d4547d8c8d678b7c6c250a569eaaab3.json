  "db_name": "PostgreSQL",
  "query": "\n        SELECT dv.id, dv.design_id, dv.s3_key, dv.sha256, dv.kind,\n               d.run_id, r.niche_id, d.base_prompt, d.s3_prefix_raw\n        FROM design_variants dv\n        JOIN designs d ON dv.design_id = d.id\n        JOIN production_runs r ON d.run_id = r.id\n        WHERE dv.id = $1\n        ",
